  "studio.mainMenu.item.insert.fallbackDescription": "Տեղադրել ցանկից դուք կարող եք կաղապարներ, ձևեր, պատկերներ, նիշեր և 3D ակտիվներ տեղադրել տեսարանի մեջ:",
  "studio.mainMenu.item.view.fallbackDescription": "Անմիջապես կարգավորեք խոշորացումը, ուղղման ռեժիմը և վահանակի դասավորությունը View մենյուի միջոցով:",
  "studio.mainMenu.item.filter.fallbackDescription": "Դուք կարող եք մշակել էկրանը պղտորման, գույնի ուղղման և կորի մշակման միջոցով ֆիլտրի ընտրացանկում:",
  "studio.mainMenu.item.draw.fallbackDescription": "Արագ անցում կատարեք կանխադրված գործիքների, ֆոնի և ներկապնակի ռեժիմների միջև Draw մենյուից:",
  "studio.mainMenu.item.ai.fallbackDescription": "Սկսեք ստեղծել օժանդակներ, ֆոնդային պատկերներ և կապել կարգավորումները AI մենյուի միջոցով:",
  "studio.mainMenu.hint.file.title": "ֆայլ",
  "studio.mainMenu.hint.file.description": "Պահպանեք և ներմուծեք ձեռագրերը և արտահանեք դրանք որպես պատկերներ, PSD-ներ, նախագծերի կրկնօրինակում և հրապարակման արդյունքներ:",
  "studio.mainMenu.hint.file.tip": "Աշխատելիս օգտագործեք ժամանակավոր պահեստ և արխիվացրեք ակտիվներ պարունակող կրկնօրինակները՝ նախքան սարքերը տեղափոխելը:",
  "studio.mainMenu.hint.edit.title": "խմբագրել",
  "studio.mainMenu.hint.edit.description": "Բռնակներ հետարկել, clipboard, ընտրության վերահսկում, շերտի կարգը, եւ կարգավորումների ընտրացանկը մեկ քայլով:",
  "studio.mainMenu.hint.edit.tip": "Մենյու մտնելուց հետո կարող եք շարժվել ↑·↓ և Home·End-ով և կատարել հրամաններ Enter-ով։",
  "studio.mainMenu.hint.insert.title": "ներդիր",
  "studio.mainMenu.hint.insert.description": "Ավելացրեք ձևանմուշներ, խոսքի փուչիկներ, տեքստ, պատկերներ և 3D նիշեր և նախապատկերներ անմիջապես ընթացիկ տեսարանին:",
  "studio.mainMenu.hint.insert.tip": "Հաճախ օգտագործվող խոսքի փուչիկները և ակտիվները կարող են անմիջապես բացվել լայն էկրանի դյուրանցումներից:",
  "studio.mainMenu.hint.view.title": "դիտել",
