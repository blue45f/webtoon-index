    "maxTrianglesLod1": 95000,
    "maxTrianglesLod2": 48000,
    "maxHairTrianglesLod0": 30000,
    "maxHairMaterials": 3,
    "maxVertexInfluences": 4,
    "maxTextureSize": 4096,
    "maxUnappliedScaleDelta": 0.001,
    "maxDegenerateFaces": 0,
    "maxNonManifoldEdges": 64,
    "minimumScore": 86
