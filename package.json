{
  "name": "toonspectrum",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "prepare": "husky && git config core.hooksPath .husky",
    "dev": "vite --host 0.0.0.0",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' tsc -p tsconfig.json && NODE_OPTIONS='--max-old-space-size=8192' vite build",
    "build:bundle": "NODE_OPTIONS='--max-old-space-size=8192' vite build",
    "prebuild:bundle": "pnpm run prebuild",
    "postbuild:bundle": "pnpm run postbuild",
    "postbuild": "node scripts/generate-third-party-notices.mjs --output dist/legal/THIRD_PARTY_NOTICES.generated.md && node scripts/verify-vercel-csp.mjs dist/index.html",
    "preview": "vite preview --host 0.0.0.0",
    "start": "vite preview --host 0.0.0.0",
    "vercel:deploy": "vercel --prod",
    "vercel:preview": "vercel",
    "vercel:status": "curl -I -s https://toonspectrum.vercel.app",
    "vercel:inspect": "vercel inspect",
    "dev:api": "pnpm --filter @webtoon-nest/api dev",
    "dev:all": "pnpm -r --parallel --include-workspace-root dev",
    "crawl": "node scripts/crawl.mjs --json --no-file",
    "ingest": "node scripts/ingest.mjs",
    "catalog:gen": "tsx scripts/build-static-catalog.ts",
    "catalog:update": "node scripts/crawl.mjs --json --no-file > /tmp/toonspectrum-catalog.json && node scripts/merge-catalog.mjs /tmp/toonspectrum-catalog.json && pnpm catalog:gen",
    "related:crawl": "node scripts/crawl-related-info.mjs",
    "related:update": "node scripts/crawl-related-info.mjs && pnpm catalog:gen",
    "kmas:fetch": "node scripts/kmas-fetch.mjs",
    "kmas:update-catalog": "node scripts/kmas-update-catalog.mjs && pnpm catalog:gen",
    "predev": "pnpm catalog:gen",
    "prebuild": "pnpm catalog:gen",
    "build:all": "pnpm -r run build",
    "lint": "NODE_OPTIONS='--max-old-space-size=8192' eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/full/",
    "lint:quick": "node scripts/lint-changed.mjs",
    "lint:quick:fix": "node scripts/lint-changed.mjs --fix",
    "lint:quick:staged": "node scripts/lint-changed.mjs --staged",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=8192' tsc -p tsconfig.json && pnpm --filter @webtoon-nest/api run typecheck",
    "typecheck:trace": "NODE_OPTIONS='--max-old-space-size=8192' tsc -p tsconfig.json --incremental false --generateTrace .tstrace",
    "typecheck:analyze-trace": "analyze-trace .tstrace",
    "typecheck:trace:report": "pnpm run typecheck:trace && pnpm run typecheck:analyze-trace",
    "test": "pnpm run test:root && pnpm run test:perf",
    "test:root": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:postgres:integration": "node scripts/run-postgres-integration-tests.mjs",
    "verify:creator-marketplace-db": "tsx scripts/verify-creator-marketplace-db.mts",
    "test:market:e2e": "playwright test --config playwright.market.config.ts",
    "test:market:live": "node e2e/run-market-live-e2e.mjs",
    "test:redis:integration": "node scripts/run-redis-integration-tests.mjs",
    "test:cloudflare-realtime": "vitest run --config deploy/cloudflare-realtime/vitest.config.mts",
    "typecheck:cloudflare-realtime": "tsc -p deploy/cloudflare-realtime/tsconfig.json && tsc -p deploy/cloudflare-realtime/tsconfig.integration.json",
    "verify:cloudflare-realtime": "pnpm run test:cloudflare-realtime && pnpm run typecheck:cloudflare-realtime && pnpm exec wrangler deploy --dry-run --config deploy/cloudflare-realtime/wrangler.jsonc",
    "verify:backend-capability-worker": "node scripts/canary-backend-capability-worker.mjs",
    "verify:csp": "node scripts/verify-vercel-csp.mjs apps/web/index.html",
    "validate:architecture": "node scripts/validate-architecture.mjs",
    "verify:toolchain-coverage": "node scripts/verify-toolchain-coverage.mjs",
    "check:studio-bundle": "node scripts/check-studio-bundle.mjs",
    "ci": "pnpm run validate:architecture && pnpm run verify:csp && pnpm run verify:toolchain-coverage && pnpm run lint:ci && pnpm run typecheck && pnpm run test && pnpm run verify:cloudflare-realtime && pnpm run build && pnpm run check:studio-bundle && pnpm run audit:licenses && pnpm run build:all",
    "sonar": "sonar-scanner",
    "lint:strict": "NODE_OPTIONS='--max-old-space-size=8192' eslint --max-warnings=0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/full/",
    "lint:ci": "pnpm run lint:strict",
    "audit:security": "node scripts/verify-security-advisory-exceptions.mjs && pnpm audit --prod --audit-level high",
    "audit:studio-brush-mark-distance": "tsx scripts/audit-studio-brush-mark-distance.mts",
    "audit:licenses": "node scripts/generate-third-party-notices.mjs --check",
    "lint:security": "pnpm run lint:strict && pnpm run audit:security",
    "sonar:ci": "sonar-scanner -Dsonar.qualitygate.wait=true",
    "verify": "pnpm run ci",
    "verify:push": "pnpm run verify && pnpm run audit:security && pnpm run audit:licenses",
    "db:push": "drizzle-kit push",
    "db:bootstrap:production-empty": "node scripts/bootstrap-empty-production-database.mjs",
    "db:seed": "tsx apps/api/src/db/seed.ts",
    "seed:market:dev": "node --import tsx scripts/seed/market-dev-seed.mts",
    "db:cleanup-creator-garbage": "tsx scripts/cleanup-creator-garbage.ts --dry-run",
    "db:cleanup-creator-garbage:dry-run": "tsx scripts/cleanup-creator-garbage.ts --dry-run",
    "db:cleanup-creator-garbage:delete": "tsx scripts/cleanup-creator-garbage.ts --confirm-test-users",
    "turbo:build": "pnpm exec turbo run build",
    "turbo:typecheck": "pnpm exec turbo run typecheck",
    "turbo:lint": "pnpm exec turbo run lint",
    "turbo:test": "pnpm exec turbo run test --concurrency=1",
    "bench:studio-engine": "tsx tests/benchmarks/harness/main.ts",
    "bench:filter-candidates": "tsx tests/benchmarks/harness/filter-candidates.ts",
    "soak:studio-engine": "tsx tests/benchmarks/harness/soak.ts",
    "bench:quality-lab": "tsx tests/benchmarks/harness/quality-lab.ts",
    "verify:studio-engine": "node scripts/verify-studio-engine.mjs",
    "verify:studio-launch": "tsx scripts/verify-studio-launch.mts",
    "verify:studio-lifecycle": "tsx scripts/verify-studio-lifecycle.mts",
    "verify:studio-service-worker": "tsx scripts/verify-studio-service-worker.mts",
    "verify:studio-artist-journey": "tsx scripts/verify-studio-artist-journey.mts",
    "verify:studio-autosave-opfs": "tsx scripts/verify-studio-autosave-opfs-session.mts",
    "verify:studio-autosave-two-tab": "tsx scripts/verify-studio-autosave-two-tab-leader.mts",
    "verify:studio-brushes": "tsx scripts/verify-studio-brushes.mts",
    "verify:studio-brush-media": "tsx scripts/verify-studio-brush-media.mts",
    "verify:studio-brush-latency": "tsx scripts/verify-studio-brush-latency.mts",
    "verify:studio-long-stroke": "tsx scripts/verify-studio-long-stroke.mts",
    "verify:studio-brush-planner-quality": "tsx scripts/verify-studio-brush-planner-quality.mts",
    "verify:studio-brush-engine-selection": "tsx scripts/verify-studio-brush-engine-selection.mts",
    "verify:studio-brush-catalogue-perf": "tsx scripts/studio-brush-catalogue-perf-matrix.ts",
    "verify:studio-p5-brush-real-runtime": "node scripts/verify-studio-p5-brush-real-runtime.mjs",
    "generate:studio-renderer-roles": "tsx scripts/generate-studio-renderer-roles.mts",
    "verify:studio-renderer-roles": "tsx scripts/generate-studio-renderer-roles.mts --check",
    "verify:studio-groups": "tsx scripts/verify-studio-groups.mts",
    "verify:studio-gpu-committed-parity": "tsx scripts/verify-studio-gpu-committed-parity.mts",
    "verify:studio-engine-webgpu-brush-parity": "node scripts/verify-studio-engine-webgpu-brush-parity.mjs",
    "verify:studio-engine-webgpu-filter-parity": "node scripts/verify-studio-engine-webgpu-filter-parity.mjs",
    "verify:studio-engine-webgpu-presentation": "node scripts/verify-studio-engine-webgpu-presentation.mjs",
    "verify:studio-bg3d-webgpu-engine": "node scripts/verify-studio-bg3d-webgpu-engine.mjs",
    "verify:studio-bg3d-inapp-editor": "tsx scripts/verify-studio-bg3d-inapp-editor.mts",
    "verify:studio-engine-webgpu-textured-brush": "node scripts/verify-studio-engine-webgpu-textured-brush.mjs",
    "build:studio-hokusai-wasm": "node scripts/verify-studio-hokusai-wasm.mjs --build",
    "test:studio-hokusai-wasm": "node scripts/verify-studio-hokusai-wasm.mjs --test",
    "verify:studio-hokusai-wasm": "node scripts/verify-studio-hokusai-wasm.mjs --check",
    "verify:studio-hokusai-wasm:rebuild": "node scripts/verify-studio-hokusai-wasm.mjs --rebuild",
    "verify:studio-hokusai-natural-media-quality": "node scripts/verify-studio-hokusai-natural-media-quality.mjs",
    "verify:studio-hokusai-live-brush": "node scripts/verify-studio-hokusai-live-brush.mjs",
    "verify:studio-hokusai-live-integration": "tsx scripts/verify-studio-hokusai-live-integration.mts",
    "verify:studio-living-ink-execution": "node scripts/verify-studio-living-ink-execution.mjs",
    "verify:studio-living-ink-integration": "tsx scripts/verify-studio-living-ink-integration.mts",
    "verify:studio-native-raster-tools": "tsx scripts/verify-studio-native-raster-tools.mts",
    "verify:studio-ai-quality": "tsx scripts/verify-studio-ai-quality.mts",
    "verify:studio-ux-task-benchmark": "tsx scripts/verify-studio-ux-task-benchmark.mts",
    "verify:studio-hybrid-dcc-integration": "tsx scripts/verify-studio-hybrid-dcc-integration.mts",
    "verify:studio-glb-export": "tsx scripts/verify-studio-glb-export.mjs",
    "verify:studio-engine-webgpu-tile-provider": "node scripts/verify-studio-engine-webgpu-tile-provider.mjs",
    "verify:studio-professional-bristle-webgpu": "node scripts/verify-studio-professional-bristle-webgpu.mjs",
    "verify:studio-dynamic-dual-tip-webgpu": "node scripts/verify-studio-dynamic-dual-tip-webgpu.mjs",
    "verify:studio-dynamic-dual-tip-webgpu-v2": "node scripts/verify-studio-dynamic-dual-tip-webgpu-v2.mjs",
    "verify:studio-engine-tile-storage-opfs-v2": "node scripts/verify-studio-engine-tile-storage-opfs-v2.mjs",
    "verify:studio-canvaskit-quality-worker": "node scripts/verify-studio-canvaskit-quality-worker.mjs",
    "verify:studio-vello-candidate": "tsx scripts/verify-studio-vello-candidate.mts",
    "verify:studio-gpu-filters": "tsx scripts/verify-studio-gpu-filters.mts",
    "verify:studio-bg3d-physics": "tsx scripts/verify-studio-bg3d-physics.mts",
    "verify:studio-3d-console": "tsx scripts/verify-studio-3d-console.mts",
    "verify:studio-3d-visual": "playwright test e2e/studio-3d-visual-verification.spec.ts",
    "verify:studio-bg3d-webgpu-rotation": "STUDIO_BG3D_WEBGPU_GIZMO=1 playwright test --config=playwright.bg3d-runtime.config.ts",
    "verify:studio-bg3d-webgpu-rotation:dev": "STUDIO_BG3D_WEBGPU_GIZMO=1 playwright test e2e/studio-3d-visual-verification.spec.ts --grep 'WebGPU 기즈모 연속 회전'",
    "studio:vrm-generate": "tsx scripts/studio-vrm-generate-mcp-host.mts generate",
    "studio:vrm-generate-mcp": "tsx scripts/studio-vrm-generate-mcp-host.mts",
    "studio:avatar-reference-catalogue:write": "tsx scripts/generate-studio-vrm-avatar-reference-catalogue.mts --write",
    "studio:avatar-reference-catalogue:check": "tsx scripts/generate-studio-vrm-avatar-reference-catalogue.mts --check",
    "verify:studio-character-shaper": "tsx scripts/verify-studio-character-shaper.mts",
    "verify:studio-menus": "tsx scripts/verify-studio-menus.mts",
    "verify:studio-mobile-top": "tsx scripts/verify-studio-mobile-top.mts",
    "verify:studio-inapp-browser": "tsx scripts/verify-studio-inapp-browser.mts",
    "verify:studio-inapp-feature-sweep": "tsx scripts/verify-studio-inapp-feature-sweep.mts",
    "verify:studio-canvas-chrome": "tsx scripts/verify-studio-canvas-chrome.mts",
    "verify:studio-canvas-surfaces": "tsx scripts/verify-studio-canvas-surfaces.mts",
    "verify:studio-icons": "tsx scripts/verify-studio-icons.mts",
    "verify:studio-companion": "tsx scripts/verify-studio-companion.mts",
    "verify:studio-inspector-walkthrough": "tsx scripts/verify-studio-inspector-walkthrough.mts",
    "verify:creator-logic": "tsx scripts/verify-creator-logic.mts",
    "studio:manifest:generate": "tsx scripts/generate-studio-asset-manifest.ts",
    "studio:batch": "tsx scripts/studio-asset-batch.ts",
    "studio:upload-assets": "tsx scripts/upload-toonstudio-3d-assets.mts",
    "studio:upload-assets:dry-run": "tsx scripts/upload-toonstudio-3d-assets.mts --dry-run",
    "studio:toolchain:check": "tsx scripts/studio-toolchain-check.ts",
    "studio:toolchain:setup": "tsx scripts/studio-toolchain-setup.ts",
    "studio:asset:release": "tsx scripts/studio-asset-release.ts",
    "verify:studio-filter-dialog": "tsx scripts/verify-studio-filter-dialog.mts"
  },
