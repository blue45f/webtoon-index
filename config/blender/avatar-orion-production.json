{
  "$schema": "./toonstudio-character-pipeline.schema.json",
  "version": 1,
  "characterId": "avatar-orion-authored",
  "displayName": "Avatar Orion · Authored Toon",
  "mode": "upgrade",
  "inputPath": "apps/web/public/vrm/Avatar_Orion.vrm",
  "outputDir": "batch_generated/blender-character",
  "strict": true,
  "hair": {
    "enabled": true,
    "style": "short-layered",
    "replaceDetectedHair": false,
    "volume": 0.94,
    "length": 0.78,
    "fringe": 0.36,
    "wave": 0.08,
    "clumpDensity": 0.86,
